{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "System": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/myapp-.txt",
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "CookieExpirationDays": 30,
  "Token": {
    "ExpirationTimeInHours": 24
  },
  "VerificationCode": {
    "ExpirationTimeInMinutes": 3,
    "MaxFailedAttempts": 5,
    "WaitingTimeInMinutesAfterResendEmail": 10
  },
  "EmailConfiguration": {
    "WelcomeSubject": "Bienvenido a Tienda UCN",
    "From": "your-from-email@example.com",
    "VerificationSubject": "Código de Verificación"
  },
  "Jobs": {
    "CronJobDeleteUnconfirmedUsers": "your-cron-expression-for-deleting-unconfirmed-users",
    "CronJobDeleteExpiredTokens": "your-cron-expression-for-deleting-expired-tokens",
    "TimeZone": "Pacific SA Standard Time",
    "DaysToDeleteUnverifiedAccount": 7
  },
  "HangfireDashboard": {
    "StatsPollingInterval": 7000,
    "DashboardTitle": "Panel de Control de Hangfire",
    "DashboardPath": "/your-hangfire-dashboard-path",
    "DisplayStorageConnectionString": false
  },
  "Products": {
    "FewUnitsAvailable": 15,
    "DefaultImageUrl": "https://shop.songprinting.com/global/images/PublicShop/ProductSearch/prodgr_default_300.png",
    "ImageAllowedExtensions": [
      ".jpg",
      ".jpeg",
      ".png",
      ".webp"
    ],
    "ImageMaxSizeInBytes": 5242880,
    "TransformationWidth": 1000,
    "TransformationCrop": "scale",
    "TransformationQuality": "auto:best",
    "TransformationFetchFormat": "auto"
  },
  "User": {
    "AdminUser": {
      "Name": "your-name",
      "Email": "your-email@example.com",
      "Rut": "your-rut",
      "PhoneNumber": "your-phone-number",
      "BirthDate": "1990-01-01",
      "Gender": "Otro",
      "Password": "your-password"
    },
    "RandomUserPassword": "your-random-user-password",
    "Genders": [
      "Masculino",
      "Femenino",
      "Otro"
    ]
  }
}